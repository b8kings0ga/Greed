# Native Mimir environment; literal KEY=VALUE lines, not shell syntax.


CONF_bark.paths.nomad_data_dir=/var/lib/ratatoskr/nomad
CONF_nomad.data_dir=/var/lib/ratatoskr/nomad
CONF_bark.yggdrasil_interface=tun0
CONF_yggdrasil.if_name=tun0
CONF_bark.dns.listen=["[::1]:53"]
CONF_yggdrasil.peers=["tcp://107.172.111.190:14444"]
CONF_nomad.client.server_join.retry_join=["[200:5767:9845:66c:ab1:874e:7653:46a5]:14647"]
CONF_bark.identity.nats_urls=["nats://[200:5767:9845:66c:ab1:874e:7653:46a5]:14222"]
CONF_bark.dns.nats_urls=["nats://[200:5767:9845:66c:ab1:874e:7653:46a5]:14222"]

CONF_bark.paths.yggdrasil_config=/var/lib/ratatoskr/yggdrasil/yggdrasil.conf
CONF_bark.docker_host.mode=disabled
CONF_bark.docker_registry.configure_docker=false
CONF_nomad.client.options={"driver.allowlist":"mimc,raw_exec,exec"}
CONF_nomad.server.enabled=false
CONF_bark.machine_preset=compact
GOMEMLIMIT=512MiB
GOMAXPROCS=2
CONF_bark.vegvisir.enabled=true
CONF_bark.vegvisir.file=/etc/ratatoskr/vegvisir.json

# Hostname TLS probe works on networks that block direct-IP HTTPS.
CONF_bark.identity.trace_urls=["https://cloudflare.com/cdn-cgi/trace","https://1.1.1.1/cdn-cgi/trace"]
CONF_nomad.mimc_resource_enforcement=true
# SLIRP/AVF guest addresses are not reachable LAN service endpoints.
CONF_bark.network_paths.disable_non_loopback_lan=true

# Mobile nodes explicitly leave on a normal shutdown.
CONF_nomad.leave_on_terminate=true
CONF_nomad.leave_on_interrupt=true

# Membership allocations reach the authenticated QLite gateway over mim0.
CONF_bark.qlite.listen=0.0.0.0:14227
