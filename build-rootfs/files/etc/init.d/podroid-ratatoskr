#!/sbin/openrc-run
description="Podroid native Mimir node runtime"
command="/usr/local/bin/podroid-ratatoskr-run"
supervisor="supervise-daemon"
respawn_delay=10
respawn_max=0
respawn_period=120
output_log="/var/log/ratatoskr.log"
error_log="/var/log/ratatoskr.log"

depend() {
    need podroid-network podroid-bootstrap
    after podroid-migrate dropbear dnsmasq.lxcbr0 podroid-x11
    before podroid-ready
}

start_pre() {
    mkdir -p /mnt/persist/ratatoskr /var/lib/ratatoskr /var/log
    mountpoint -q /var/lib/ratatoskr || mount --bind /mnt/persist/ratatoskr /var/lib/ratatoskr || return 1
    # Keep both runtime identity/config and scheduler state across app updates.
    mkdir -p /var/lib/ratatoskr/yggdrasil /var/lib/ratatoskr/nomad
    # Mimir helpers also inspect the standard path; retain the original data ID.
    mkdir -p /opt/nomad
    [ -e /opt/nomad/data ] || ln -s /var/lib/ratatoskr/nomad /opt/nomad/data
    for item in cpu_total_compute memory_total_mb reserved_memory_mb; do
        value=$(sed -n "s/.*ratatoskr.$item=\([^ ]*\).*/\1/p" /proc/cmdline)
        case "$value" in ''|*[!0-9]*) continue ;; esac
        case "$item" in reserved_memory_mb) key=reserved.memory ;; memory_total_mb) key=memory_total_mb ;; *) key=cpu_total_compute ;; esac
        printf 'CONF_nomad.client.%s=%s\n' "$key" "$value"
    done > /run/ratatoskr-resources.env
    test -x /usr/local/bin/ratatoskr && test -x /usr/local/bin/nomad && test -x /usr/local/bin/mim-net
}

stop_pre() {
    # A routine Ratatoskr restart must leave the independently supervised
    # Nomad agent running. The offline helper SIGSTOPs Nomad for VM shutdown.
    [ "${RC_CMD:-}" = restart ] && return 0
    # Run before Ratatoskr tears down Yggdrasil. Failure must not prevent poweroff.
    if /usr/local/bin/podroid-node-offline > /run/podroid-offline-result 2>&1; then
        cat /run/podroid-offline-result > /dev/console
    else
        cat /run/podroid-offline-result > /dev/console
        ewarn "Offline notification failed; server heartbeat expiry remains the fallback"
    fi
}
